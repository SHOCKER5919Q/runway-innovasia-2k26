# Copy to backend/.env and edit. Everything here has a working default.

# --- application ---
RUNWAY_ENV=demo                      # demo | development | production
RUNWAY_DEBUG=true

# --- persistence ---
# SQLite by default so nothing external is needed. The ORM is portable:
# RUNWAY_DATABASE_URL=postgresql+psycopg://runway:runway@localhost:5432/runway
# RUNWAY_DATABASE_URL=sqlite:////absolute/path/to/runway.db

# --- security ---
# MUST be replaced in any deployment. 32+ bytes of real entropy.
RUNWAY_SECRET_KEY=dev-only-insecure-key-change-me-in-production-0001
RUNWAY_ACCESS_TOKEN_MINUTES=720
RUNWAY_RATE_LIMIT_PER_MINUTE=240
RUNWAY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- forecasting ---
RUNWAY_FORECAST_HORIZON_WEEKS=13
RUNWAY_MONTE_CARLO_PATHS=4000
RUNWAY_MONTE_CARLO_SEED=20260101
RUNWAY_VAR_CONFIDENCE=0.95

# --- AI copilot (optional) ---
# Without a key the copilot answers from the same deterministic tool output
# using a built-in renderer. The figures are identical either way.
# RUNWAY_ANTHROPIC_API_KEY=sk-ant-...
RUNWAY_COPILOT_MODEL=claude-opus-5
